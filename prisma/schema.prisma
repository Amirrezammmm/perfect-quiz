generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}


enum QuestionCategory {
  IDEOLOGICAL
  POLITICAL
  GENERAL
}

enum QuestionStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  ARCHIVED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Question {
  id             String           @id @default(cuid())

  title          String
  normalizedText String?
  explanation    String?

  category       QuestionCategory @default(GENERAL)
  status         QuestionStatus   @default(DRAFT)

  sourcePage     Int?
  sourceNumber   Int?

  importBatchId  String?
  importBatch    ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  options        Option[]
  examAnswers    ExamAnswer[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category])
  @@index([status])
  @@index([importBatchId])
}

model Option {
  id          String   @id @default(cuid())

  text        String
  isCorrect   Boolean  @default(false)
  order       Int

  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([questionId])
}

model Exam {
  id          String       @id @default(cuid())

  title       String
  description String?
  duration    Int?

  results     ExamResult[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ExamResult {
  id              String       @id @default(cuid())

  userName        String?
  score           Int          @default(0)
  totalQuestions  Int          @default(0)
  correctCount    Int          @default(0)
  wrongCount      Int          @default(0)
  unansweredCount Int          @default(0)

  startedAt       DateTime     @default(now())
  finishedAt      DateTime?

  examId          String
  exam            Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  answers         ExamAnswer[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([examId])
}

model ExamAnswer {
  id               String     @id @default(cuid())

  selectedOptionId String?
  isCorrect        Boolean    @default(false)

  questionId       String
  question         Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  resultId         String
  result           ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  createdAt        DateTime   @default(now())

  @@index([questionId])
  @@index([resultId])
}

model ImportBatch {
  id              String       @id @default(cuid())

  filename        String
  originalName    String?
  mimeType        String?
  fileSize        Int?

  status          ImportStatus @default(PENDING)

  totalPages      Int?
  totalQuestions  Int          @default(0)
  importedCount   Int          @default(0)
  failedCount     Int          @default(0)

  notes           String?
  errorMessage    String?

  questions       Question[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
